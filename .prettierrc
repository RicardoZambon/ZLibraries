{
  "singleQuote": true,
  "printWidth": 120,
  "tabWidth": 2,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "proseWrap": "preserve"
      }
    },
    {
      "files": "apps/docs/src/app/**/*.html",
      "options": {
        "parser": "angular"
      }
    }
  ]
}
