{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/libs/framework",
  "assets": [
    {
      "glob": "CHANGELOG.md",
      "input": ".",
      "output": "."
    },
    {
      "glob": "**/*.json",
      "input": "src/i18n",
      "output": "i18n"
    }
  ],
  "lib": {
    "entryFile": "src/index.ts"
  }
}
