{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "../../../dist/libs/ui/schematics"
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
