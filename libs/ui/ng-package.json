{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/libs/ui",
  "assets": [
    {
      "glob": "README.md",
      "input": ".",
      "output": "."
    },
    {
      "glob": "CHANGELOG.md",
      "input": ".",
      "output": "."
    },
    {
      "glob": "**/*.scss",
      "input": "src/styles",
      "output": "styles"
    },
    {
      "glob": "**/*.css",
      "input": "src/styles",
      "output": "styles"
    }
  ],
  "lib": {
    "entryFile": "src/index.ts"
  }
}
